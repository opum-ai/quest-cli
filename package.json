{
  "name": "@opum-ai/quest",
  "version": "0.2.5",
  "description": "Quest CLI tracker subprocess contract.",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opum-ai/quest-cli.git"
  },
  "bin": {
    "quest": "./bin/quest.cjs"
  },
  "files": [
    "bin/quest.cjs",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src test scripts biome.json package.json tsconfig.json",
    "format": "biome format --write .",
    "format:check": "biome ci --linter-enabled=false --assist-enabled=false src test scripts biome.json package.json tsconfig.json",
    "layer:check": "node scripts/check-layers.mjs",
    "build:packages": "bun run scripts/build-platform-packages.mjs",
    "check:packages": "bun run scripts/check-package-artifacts.mjs",
    "test:packages": "bun run scripts/test-packed-packages.mjs",
    "test:repository-check-scope": "node scripts/test-repository-check-scope.mjs",
    "test": "bun run test:repository-check-scope && bun test",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run layer:check && bun run test"
  },
  "optionalDependencies": {
    "@opum-ai/quest-darwin-arm64": "0.2.5",
    "@opum-ai/quest-darwin-x64": "0.2.5",
    "@opum-ai/quest-linux-arm64": "0.2.5",
    "@opum-ai/quest-linux-x64": "0.2.5",
    "@opum-ai/quest-win32-arm64": "0.2.5",
    "@opum-ai/quest-win32-x64": "0.2.5"
  },
  "questPlatformPackages": {
    "@opum-ai/quest-darwin-arm64": "a7534f94341934b9ef82f6679b98068236ef397610701cc047c4afeffefd2282",
    "@opum-ai/quest-darwin-x64": "35768cc224d4fdef4d86eec126cb8b1821d4281b896571feff3acf0e02b72880",
    "@opum-ai/quest-linux-arm64": "f27d4f037b42da2b252b5c7766d7e90ab59bbb354dd069376e75684d2a9d0292",
    "@opum-ai/quest-linux-x64": "9239fad60254a77b0a1d6a6e569f901adf190879c80ba7aa2e808c0f930bad0d",
    "@opum-ai/quest-win32-arm64": "7630edc85cfb3618f1eb6d2a1925965b8b70a28490a8a716214f345d14d335cd",
    "@opum-ai/quest-win32-x64": "b1264951887bc3ae6f5ee0ed96c66fd7798b899c72f4d2c3b43975fde7e517a6"
  },
  "dependencies": {
    "commander": "15.0.0",
    "js-yaml": "5.3.0",
    "string-width": "8.2.2",
    "unicode-case-folding": "^1.1.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/bun": "1.3.14",
    "typescript": "7.0.2"
  }
}
