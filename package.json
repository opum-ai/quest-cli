{
  "name": "@opum-ai/quest",
  "version": "0.13.0",
  "description": "Deterministic, LLM-free task tracker CLI — the record layer coding agents and humans write to.",
  "license": "MIT",
  "author": "Opum AI",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=18"
  },
  "homepage": "https://questgraph.dev",
  "bugs": {
    "url": "https://github.com/opum-ai/quest-cli/issues"
  },
  "keywords": [
    "cli",
    "task-tracker",
    "project-management",
    "issue-tracking",
    "ai-agents",
    "claude-code"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opum-ai/quest-cli.git"
  },
  "bin": {
    "quest": "./bin/quest.cjs"
  },
  "files": [
    "bin/quest.cjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src test scripts hooks types tests biome.json package.json tsconfig.json",
    "format": "biome format --write .",
    "format:check": "biome ci --linter-enabled=false --assist-enabled=false src test scripts hooks types tests biome.json package.json tsconfig.json",
    "layer:check": "node scripts/check-layers.mjs",
    "build:packages": "bun run scripts/build-platform-packages.mjs",
    "check:packages": "bun run scripts/check-package-artifacts.mjs",
    "check:lockfile": "node scripts/check-lockfile-pins.mjs",
    "check:breaking-bump": "node scripts/check-breaking-bump.mjs",
    "check:breaking-bump:pair": "node scripts/check-breaking-bump.mjs --pair",
    "test:packages": "QUEST_AGENT_PLUGINS=off bun run scripts/test-packed-packages.mjs",
    "qualify:migration-artifact": "bun run scripts/qualification/migration-lifecycle.mjs",
    "deliver:packages": "bun run scripts/deliver-package-artifacts.mjs",
    "test:package-artifact-delivery": "bun run scripts/test-package-artifact-delivery.mjs",
    "test:repository-check-scope": "node scripts/test-repository-check-scope.mjs",
    "test:mod": "node scripts/mod-test.mjs",
    "test": "bun run test:repository-check-scope && bun run test:package-artifact-delivery && QUEST_AGENT_PLUGINS=off bun test --path-ignore-patterns='tests/**'",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run layer:check && bun run test && bun run test:mod",
    "receipt:emit": "node scripts/qualification/native-execution-receipt.mjs",
    "receipt:require": "node scripts/qualification/native-execution-receipt.mjs --require",
    "receipt:verify-published": "node scripts/qualification/native-execution-receipt.mjs --verify-published",
    "build:candidate": "node scripts/build-candidate-bundle.mjs",
    "publish:release": "node scripts/publish-release.mjs"
  },
  "optionalDependencies": {
    "@opum-ai/quest-darwin-arm64": "0.13.0",
    "@opum-ai/quest-darwin-x64": "0.13.0",
    "@opum-ai/quest-linux-arm64": "0.13.0",
    "@opum-ai/quest-linux-x64": "0.13.0",
    "@opum-ai/quest-win32-arm64": "0.13.0",
    "@opum-ai/quest-win32-x64": "0.13.0"
  },
  "questPlatformPackages": {
    "@opum-ai/quest-darwin-arm64": "cd438a04de91fc9fad59aef1f4fbf5657d378128f47467e13952a259e06998cd",
    "@opum-ai/quest-darwin-x64": "0bcd9342a578f32ffafb6cadbaafd26fb9a17e96ac216c7e63abc270639b2f3d",
    "@opum-ai/quest-linux-arm64": "7bcf550b1cd432115de1dd55b20cdddea6dc1ed6d9af378b94ae7bb58034d838",
    "@opum-ai/quest-linux-x64": "88264b61c42bcaeea10a3866010dcc52264bb6e521a558be4a699c8a47db09ed",
    "@opum-ai/quest-win32-arm64": "4f6f1949c44c34a0288a90bf0fd3c5632b81bb5e83e51dd683a74d43b9644c29",
    "@opum-ai/quest-win32-x64": "3f5eeeeff0d68366b31beb09ab87a8c446e293d2f5fece5a1733a7a289b25853"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.0",
    "commander": "15.0.0",
    "js-yaml": "5.3.0",
    "string-width": "8.2.2",
    "unicode-case-folding": "^1.1.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  }
}
