{
  "name": "@opum-ai/quest",
  "version": "0.2.7",
  "description": "Quest CLI tracker subprocess contract.",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opum-ai/quest-cli.git"
  },
  "bin": {
    "quest": "./bin/quest.cjs"
  },
  "files": [
    "bin/quest.cjs",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src test scripts biome.json package.json tsconfig.json",
    "format": "biome format --write .",
    "format:check": "biome ci --linter-enabled=false --assist-enabled=false src test scripts biome.json package.json tsconfig.json",
    "layer:check": "node scripts/check-layers.mjs",
    "build:packages": "bun run scripts/build-platform-packages.mjs",
    "check:packages": "bun run scripts/check-package-artifacts.mjs",
    "test:packages": "bun run scripts/test-packed-packages.mjs",
    "qualify:migration-artifact": "bun run scripts/qualification/migration-lifecycle.mjs",
    "deliver:packages": "bun run scripts/deliver-package-artifacts.mjs",
    "test:package-artifact-delivery": "bun run scripts/test-package-artifact-delivery.mjs",
    "test:repository-check-scope": "node scripts/test-repository-check-scope.mjs",
    "test": "bun run test:repository-check-scope && bun run test:package-artifact-delivery && bun test",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run layer:check && bun run test"
  },
  "optionalDependencies": {
    "@opum-ai/quest-darwin-arm64": "0.2.7",
    "@opum-ai/quest-darwin-x64": "0.2.7",
    "@opum-ai/quest-linux-arm64": "0.2.7",
    "@opum-ai/quest-linux-x64": "0.2.7",
    "@opum-ai/quest-win32-arm64": "0.2.7",
    "@opum-ai/quest-win32-x64": "0.2.7"
  },
  "questPlatformPackages": {
    "@opum-ai/quest-darwin-arm64": "4f5b194853c842a3d11fa655509e0b67c1abc425fc672c0f01d310a0ae021ffa",
    "@opum-ai/quest-darwin-x64": "d5ee36da2cf71315271da09ab90e30b51270bb4b34a85ed1876dad4e1b4ded1b",
    "@opum-ai/quest-linux-arm64": "053df0a62f25c3e611bb71f1dbdf23e7646f4c94e77cedd6e5de41057a1783a1",
    "@opum-ai/quest-linux-x64": "70bc002a90c83a66d93a68a73acb374654142f0a206faeb886e9d054751b0886",
    "@opum-ai/quest-win32-arm64": "cd22fd51d82127f6c42f686ca4a6bb14cffe8e4a7ebedcfd461ecbbf2f2dd2c8",
    "@opum-ai/quest-win32-x64": "5e87bbf1a4678235ab75d384c17f7abe8520bf0f261173ffd33e1290ecba3f0d"
  },
  "dependencies": {
    "commander": "15.0.0",
    "js-yaml": "5.3.0",
    "string-width": "8.2.2",
    "unicode-case-folding": "^1.1.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/bun": "1.3.14",
    "typescript": "7.0.2"
  }
}
