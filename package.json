  "bin": {
    "quest": "./bin/quest.cjs"
  },
  "files": [
    "bin/quest.cjs",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
