{
  "name": "@opum-ai/quest",
  "version": "0.2.4",
  "description": "Quest CLI tracker subprocess contract.",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opum-ai/quest-cli.git"
  },
  "bin": {
    "quest": "./bin/quest.cjs"
  },
  "files": [
    "bin/quest.cjs",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src test scripts biome.json package.json tsconfig.json",
    "format": "biome format --write .",
    "format:check": "biome ci --linter-enabled=false --assist-enabled=false src test scripts biome.json package.json tsconfig.json",
    "layer:check": "node scripts/check-layers.mjs",
    "build:packages": "bun run scripts/build-platform-packages.mjs",
    "check:packages": "bun run scripts/check-package-artifacts.mjs",
    "test:packages": "bun run scripts/test-packed-packages.mjs",
    "test:repository-check-scope": "node scripts/test-repository-check-scope.mjs",
    "test": "bun run test:repository-check-scope && bun test",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run layer:check && bun run test"
  },
  "optionalDependencies": {
    "@opum-ai/quest-darwin-arm64": "0.2.4",
    "@opum-ai/quest-darwin-x64": "0.2.4",
    "@opum-ai/quest-linux-arm64": "0.2.4",
    "@opum-ai/quest-linux-x64": "0.2.4",
    "@opum-ai/quest-win32-arm64": "0.2.4",
    "@opum-ai/quest-win32-x64": "0.2.4"
  },
  "questPlatformPackages": {
    "@opum-ai/quest-darwin-arm64": "46624c83a2de08f0a4038086e96b5ede95cf22d1c2f9de7e56c0e00ecd9aba5e",
    "@opum-ai/quest-darwin-x64": "154bda272f090d42e04cfc33a147c7ccd29111ac7e38345d9d7e901f6eb2e093",
    "@opum-ai/quest-linux-arm64": "d37dd8c07f34b0727c835f1ba35ca556391e2b5b76aac440cefd070b9ab83f4e",
    "@opum-ai/quest-linux-x64": "9cacd463b2d9662f5e9d04e486d006650aee4cb884520184cce7466ec1298ec4",
    "@opum-ai/quest-win32-arm64": "c5f30b587a10ce8fdb75c1834a94fd46dbd1f4136a7afa564ebdb07e36e8f90e",
    "@opum-ai/quest-win32-x64": "602ba8e5da87309d8ecf81419f1443e6d98da71239cb08eb87f2c0da00db38e3"
  },
  "dependencies": {
    "commander": "15.0.0",
    "js-yaml": "5.3.0",
    "string-width": "8.2.2",
    "unicode-case-folding": "^1.1.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/bun": "1.3.14",
    "typescript": "7.0.2"
  }
}
