{
  "name": "@opum-ai/quest",
  "version": "0.3.2",
  "description": "Quest CLI tracker subprocess contract.",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opum-ai/quest-cli.git"
  },
  "bin": {
    "quest": "./bin/quest.cjs"
  },
  "files": [
    "bin/quest.cjs",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src test scripts biome.json package.json tsconfig.json",
    "format": "biome format --write .",
    "format:check": "biome ci --linter-enabled=false --assist-enabled=false src test scripts biome.json package.json tsconfig.json",
    "layer:check": "node scripts/check-layers.mjs",
    "build:packages": "bun run scripts/build-platform-packages.mjs",
    "check:packages": "bun run scripts/check-package-artifacts.mjs",
    "test:packages": "bun run scripts/test-packed-packages.mjs",
    "qualify:migration-artifact": "bun run scripts/qualification/migration-lifecycle.mjs",
    "deliver:packages": "bun run scripts/deliver-package-artifacts.mjs",
    "test:package-artifact-delivery": "bun run scripts/test-package-artifact-delivery.mjs",
    "test:repository-check-scope": "node scripts/test-repository-check-scope.mjs",
    "test": "bun run test:repository-check-scope && bun run test:package-artifact-delivery && bun test",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run layer:check && bun run test",
    "receipt:emit": "node scripts/qualification/native-execution-receipt.mjs",
    "receipt:require": "node scripts/qualification/native-execution-receipt.mjs --require",
    "receipt:verify-published": "node scripts/qualification/native-execution-receipt.mjs --verify-published",
    "build:candidate": "node scripts/build-candidate-bundle.mjs",
    "publish:release": "node scripts/publish-release.mjs"
  },
  "optionalDependencies": {
    "@opum-ai/quest-darwin-arm64": "0.3.2",
    "@opum-ai/quest-darwin-x64": "0.3.2",
    "@opum-ai/quest-linux-arm64": "0.3.2",
    "@opum-ai/quest-linux-x64": "0.3.2",
    "@opum-ai/quest-win32-arm64": "0.3.2",
    "@opum-ai/quest-win32-x64": "0.3.2"
  },
  "questPlatformPackages": {
    "@opum-ai/quest-darwin-arm64": "7a4461d5413aeb09454a9d1de609309ae643a6facd2714574bb712559d82e4e2",
    "@opum-ai/quest-darwin-x64": "faf0336e3788016c3ad5f0cd37c22d344ec54bf44d2cfb220039eca6367d1c83",
    "@opum-ai/quest-linux-arm64": "ed47399903753b6532daf3d17e7b9b9ccf02a8c986eff5bb27af2031dffd5cc8",
    "@opum-ai/quest-linux-x64": "750d4b3762cf93257f3e41036639fb383703cf74a3de31be91cbcb998b485690",
    "@opum-ai/quest-win32-arm64": "c4446b0e90cc7194c83a4d258f61cce7ca42b7e3fc183b1a0caa718456027ada",
    "@opum-ai/quest-win32-x64": "71a6fabb810078e5846ee9c5e5584e52797932ee2344ebbcf153a9e57192d6e7"
  },
  "dependencies": {
    "commander": "15.0.0",
    "js-yaml": "5.3.0",
    "string-width": "8.2.2",
    "unicode-case-folding": "^1.1.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/bun": "1.3.14",
    "typescript": "7.0.2"
  }
}
