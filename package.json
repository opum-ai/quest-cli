{
  "name": "@opum-ai/quest",
  "version": "0.2.6",
  "description": "Quest CLI tracker subprocess contract.",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opum-ai/quest-cli.git"
  },
  "bin": {
    "quest": "./bin/quest.cjs"
  },
  "files": [
    "bin/quest.cjs",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src test scripts biome.json package.json tsconfig.json",
    "format": "biome format --write .",
    "format:check": "biome ci --linter-enabled=false --assist-enabled=false src test scripts biome.json package.json tsconfig.json",
    "layer:check": "node scripts/check-layers.mjs",
    "build:packages": "bun run scripts/build-platform-packages.mjs",
    "check:packages": "bun run scripts/check-package-artifacts.mjs",
    "test:packages": "bun run scripts/test-packed-packages.mjs",
    "deliver:packages": "bun run scripts/deliver-package-artifacts.mjs",
    "test:package-artifact-delivery": "bun run scripts/test-package-artifact-delivery.mjs",
    "test:repository-check-scope": "node scripts/test-repository-check-scope.mjs",
    "test": "bun run test:repository-check-scope && bun run test:package-artifact-delivery && bun test",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run layer:check && bun run test"
  },
  "optionalDependencies": {
    "@opum-ai/quest-darwin-arm64": "0.2.6",
    "@opum-ai/quest-darwin-x64": "0.2.6",
    "@opum-ai/quest-linux-arm64": "0.2.6",
    "@opum-ai/quest-linux-x64": "0.2.6",
    "@opum-ai/quest-win32-arm64": "0.2.6",
    "@opum-ai/quest-win32-x64": "0.2.6"
  },
  "questPlatformPackages": {
    "@opum-ai/quest-darwin-arm64": "a47f44e3333877204ed0dd9ad5e995aa9b49594badb19b50f2eeb7b2ef0714d5",
    "@opum-ai/quest-darwin-x64": "3b79c0b8bce99ea34f056cddc21f0d3d9e34bed5c250e551bd7214bdc61139cd",
    "@opum-ai/quest-linux-arm64": "527a3e41bd5b8f2cc6cdf324fbbfed35bdc7af321e8adb4231b55694585a92bd",
    "@opum-ai/quest-linux-x64": "57ce64244fbfa971cf7060f6e1a1395de20ac9612604249fff84771a957b31a8",
    "@opum-ai/quest-win32-arm64": "98a63a012620166cd655f3f91df9cb96e7ae23c776cad1776647c80b6611c1a3",
    "@opum-ai/quest-win32-x64": "7dafd97889e90f5c610a75edf103b6d6a07e511020e615cb87ae0b975f1e91ca"
  },
  "dependencies": {
    "commander": "15.0.0",
    "js-yaml": "5.3.0",
    "string-width": "8.2.2",
    "unicode-case-folding": "^1.1.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/bun": "1.3.14",
    "typescript": "7.0.2"
  }
}
