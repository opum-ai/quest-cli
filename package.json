{
  "name": "@opum-ai/quest",
  "version": "0.2.3",
  "description": "Quest CLI tracker subprocess contract.",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opum-ai/quest-cli.git"
  },
  "bin": {
    "quest": "./bin/quest.cjs"
  },
  "files": [
    "bin/quest.cjs",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src test scripts biome.json package.json tsconfig.json",
    "format": "biome format --write .",
    "format:check": "biome ci --linter-enabled=false --assist-enabled=false src test scripts biome.json package.json tsconfig.json",
    "layer:check": "node scripts/check-layers.mjs",
    "build:packages": "bun run scripts/build-platform-packages.mjs",
    "check:packages": "bun run scripts/check-package-artifacts.mjs",
    "test:packages": "bun run scripts/test-packed-packages.mjs",
    "test:repository-check-scope": "node scripts/test-repository-check-scope.mjs",
    "test": "bun run test:repository-check-scope && bun test",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run layer:check && bun run test"
  },
  "optionalDependencies": {
    "@opum-ai/quest-darwin-arm64": "0.2.3",
    "@opum-ai/quest-darwin-x64": "0.2.3",
    "@opum-ai/quest-linux-arm64": "0.2.3",
    "@opum-ai/quest-linux-x64": "0.2.3",
    "@opum-ai/quest-win32-arm64": "0.2.3",
    "@opum-ai/quest-win32-x64": "0.2.3"
  },
  "questPlatformPackages": {
    "@opum-ai/quest-darwin-arm64": "c1b31c4335e1299c0b317f0282d19476cfd7633563e3bae8aa6dbc7e69fa8b47",
    "@opum-ai/quest-darwin-x64": "a96944c39130e33c88bfa85bbed6337c84d076710ac7b98a115287c30abeaaa7",
    "@opum-ai/quest-linux-arm64": "249c49f1db075f1e41ae6a854ea06ddff7b3f1c4aca0234636a583f6c3bd4b36",
    "@opum-ai/quest-linux-x64": "6ee8892bae38c64446e9d5741c3a31c0ff7cfbfd2ff56bb10dd7cdba51bfa66d",
    "@opum-ai/quest-win32-arm64": "222d580522c221cd1db2825f52db0e05c697fd97133a45eb49f8cbf79f9a6955",
    "@opum-ai/quest-win32-x64": "e4d5a1c77e78bf1751871f5186c45fe6761ff38b7df2b433de652e0b0109b3b3"
  },
  "dependencies": {
    "commander": "15.0.0",
    "js-yaml": "5.3.0",
    "string-width": "8.2.2",
    "unicode-case-folding": "^1.1.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/bun": "1.3.14",
    "typescript": "7.0.2"
  }
}
