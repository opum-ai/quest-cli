{
  "name": "@opum-ai/quest",
  "version": "0.11.0",
  "description": "Deterministic, LLM-free task tracker CLI — the record layer coding agents and humans write to.",
  "license": "MIT",
  "author": "Opum AI",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=18"
  },
  "homepage": "https://questgraph.dev",
  "bugs": {
    "url": "https://github.com/opum-ai/quest-cli/issues"
  },
  "keywords": [
    "cli",
    "task-tracker",
    "project-management",
    "issue-tracking",
    "ai-agents",
    "claude-code"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opum-ai/quest-cli.git"
  },
  "bin": {
    "quest": "./bin/quest.cjs"
  },
  "files": [
    "bin/quest.cjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src test scripts biome.json package.json tsconfig.json",
    "format": "biome format --write .",
    "format:check": "biome ci --linter-enabled=false --assist-enabled=false src test scripts biome.json package.json tsconfig.json",
    "layer:check": "node scripts/check-layers.mjs",
    "build:packages": "bun run scripts/build-platform-packages.mjs",
    "check:packages": "bun run scripts/check-package-artifacts.mjs",
    "check:lockfile": "node scripts/check-lockfile-pins.mjs",
    "check:breaking-bump": "node scripts/check-breaking-bump.mjs",
    "check:breaking-bump:pair": "node scripts/check-breaking-bump.mjs --pair",
    "test:packages": "QUEST_AGENT_PLUGINS=off bun run scripts/test-packed-packages.mjs",
    "qualify:migration-artifact": "bun run scripts/qualification/migration-lifecycle.mjs",
    "deliver:packages": "bun run scripts/deliver-package-artifacts.mjs",
    "test:package-artifact-delivery": "bun run scripts/test-package-artifact-delivery.mjs",
    "test:repository-check-scope": "node scripts/test-repository-check-scope.mjs",
    "test": "bun run test:repository-check-scope && bun run test:package-artifact-delivery && QUEST_AGENT_PLUGINS=off bun test",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run layer:check && bun run test",
    "receipt:emit": "node scripts/qualification/native-execution-receipt.mjs",
    "receipt:require": "node scripts/qualification/native-execution-receipt.mjs --require",
    "receipt:verify-published": "node scripts/qualification/native-execution-receipt.mjs --verify-published",
    "build:candidate": "node scripts/build-candidate-bundle.mjs",
    "publish:release": "node scripts/publish-release.mjs"
  },
  "optionalDependencies": {
    "@opum-ai/quest-darwin-arm64": "0.11.0",
    "@opum-ai/quest-darwin-x64": "0.11.0",
    "@opum-ai/quest-linux-arm64": "0.11.0",
    "@opum-ai/quest-linux-x64": "0.11.0",
    "@opum-ai/quest-win32-arm64": "0.11.0",
    "@opum-ai/quest-win32-x64": "0.11.0"
  },
  "questPlatformPackages": {
    "@opum-ai/quest-darwin-arm64": "d6a10b429194a7eb2f878d673bb9d223ed049c50d36ca2f2038f312139c62c0d",
    "@opum-ai/quest-darwin-x64": "c2b33c6d63fd37fa63af340aa02f04ff8b4964fe6cc755e38c2113538f282246",
    "@opum-ai/quest-linux-arm64": "6a075df06175053886c393ed0150245d69723a732780393ccd72487e99329690",
    "@opum-ai/quest-linux-x64": "d4efba2537fdc455d5f2f993349fbc5caf6848cfea2c351232a821a7e255826e",
    "@opum-ai/quest-win32-arm64": "900225f29c004b4c9f7e9c180d8053ee4c84a17ab56eb04291062033a359b506",
    "@opum-ai/quest-win32-x64": "3094f8c52d39ecdd43a2a9210d65c3872adf159c3bab50d47ed3b58aa6192462"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.0",
    "commander": "15.0.0",
    "js-yaml": "5.3.0",
    "string-width": "8.2.2",
    "unicode-case-folding": "^1.1.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  }
}
