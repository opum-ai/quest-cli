{
  "name": "@opum-ai/quest",
  "version": "0.2.2",
  "description": "Quest CLI tracker subprocess contract.",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opum-ai/quest-cli.git"
  },
  "bin": {
    "quest": "./bin/quest.cjs"
  },
  "files": [
    "bin/quest.cjs",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src test scripts biome.json package.json tsconfig.json",
    "format": "biome format --write .",
    "format:check": "biome ci --linter-enabled=false --assist-enabled=false src test scripts biome.json package.json tsconfig.json",
    "layer:check": "node scripts/check-layers.mjs",
    "build:packages": "bun run scripts/build-platform-packages.mjs",
    "check:packages": "bun run scripts/check-package-artifacts.mjs",
    "test:packages": "bun run scripts/test-packed-packages.mjs",
    "test:repository-check-scope": "node scripts/test-repository-check-scope.mjs",
    "test": "bun run test:repository-check-scope && bun test",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run layer:check && bun run test"
  },
  "optionalDependencies": {
    "@opum-ai/quest-darwin-arm64": "0.2.2",
    "@opum-ai/quest-darwin-x64": "0.2.2",
    "@opum-ai/quest-linux-arm64": "0.2.2",
    "@opum-ai/quest-linux-x64": "0.2.2",
    "@opum-ai/quest-win32-arm64": "0.2.2",
    "@opum-ai/quest-win32-x64": "0.2.2"
  },
  "questPlatformPackages": {
    "@opum-ai/quest-darwin-arm64": "f89ad3faff24d42f8c0737738361aa8e55163c3551e73d76728a3fb7a2f6611e",
    "@opum-ai/quest-darwin-x64": "3c53b1fa06aa724ac6685ec6bab008424b5c8db6e5c7037224ceebedc38f9e98",
    "@opum-ai/quest-linux-arm64": "6c7535f556050831c440d3574d71337a82bed4ef6ec9e926d1c9335637069c6a",
    "@opum-ai/quest-linux-x64": "7c96de9b5fbad21e1c769e7d08e9297cc1790b3ae7f4328faeb1526fde5d210a",
    "@opum-ai/quest-win32-arm64": "f881e45c9ca92b180b126f8c1d621e253f7dbdf152bb2a25326717742765c354",
    "@opum-ai/quest-win32-x64": "25bc8914194f1950ace50ffa6fbed44403937ec64190ec3aae8b7c16943e7cd3"
  },
  "dependencies": {
    "commander": "15.0.0",
    "js-yaml": "5.3.0",
    "string-width": "8.2.2",
    "unicode-case-folding": "^1.1.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/bun": "1.3.14",
    "typescript": "7.0.2"
  }
}
